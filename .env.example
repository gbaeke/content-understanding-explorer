# Content Understanding Explorer settings. Copy to .env (git ignores it) and adjust; every setting in config.py is listed here.

# --- App ---------------------------------------------------------------------------------------------------------------
HOST=127.0.0.1
PORT=8809
# one JSON object per log line (on by default in Azure)
LOG_JSON=false

# --- Azure Content Understanding ------------------------------------------------------------------------------------------
# The Foundry resource's endpoint: scripts/azure-up.sh creates the resource and prints this line. Sign-in is your
# Azure login (az login), there is no key.
CONTENT_UNDERSTANDING_ENDPOINT=
